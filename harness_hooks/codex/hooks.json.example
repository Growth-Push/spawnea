{
  "hooks": {
    "SessionStart": [
      {
        "type": "command",
        "command": "/tmp/spawnea/sess-example/bin/notify.sh session_start"
      }
    ],
    "UserPromptSubmit": [
      {
        "type": "command",
        "command": "/tmp/spawnea/sess-example/bin/notify.sh user_prompt_submit"
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/tmp/spawnea/sess-example/bin/notify.sh tool_start"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/tmp/spawnea/sess-example/bin/notify.sh tool_complete"
          }
        ]
      }
    ]
  }
}
