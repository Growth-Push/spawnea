# Example Codex CLI configuration with Spawnea notification hook
# Location: ~/.codex/config.toml (or session-scoped /tmp/spawnea/<session-id>/config.toml)

# Turn Completion Notification
# When a turn completes, Codex executes this command and appends the turn JSON payload as an argument.
notify = ["/bin/sh", "/tmp/spawnea/sess-example/bin/notify.sh", "agent-turn-complete"]

# Optional: Enable experimental hooks
[features]
codex_hooks = true
